# ---------------------------------------------------------------- secrets ---
# Real values stay local; only the .env.example templates are committed.
.env*
!.env.example
!**/.env.example

# File-backed user store written at runtime by frontend/src/lib/storage.ts.
# Holds real account records (emails) — never commit it.
frontend/.data/

# ------------------------------------------------------------ dependencies ---
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ------------------------------------------------------------ build output ---
frontend/.next/
frontend/out/
frontend/build
/coverage
*.tsbuildinfo
frontend/next-env.d.ts
frontend/src/generated/prisma

# Atomic-write temp files (storage.ts writes .tmp then renames).
*.tmp

# ------------------------------------------------------ tooling / editors ---
# graphify knowledge graph: regenerate with `/graphify . --update`. Large,
# generated, and goes stale the moment the source changes.
graphify-out/
# Skill scratch output, consistent with .gstack/ and .impeccable/ below.
design-dna.json
.gstack/
.impeccable/
.obsidian/
.vscode/

# ------------------------------------------------------- local-only docs ---
PRD.md
CLAUDE.md

# ------------------------------------------------------------------ noise ---
.DS_Store
Thumbs.db
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
prisma-error*.log
prisma-format.log

# ----------------------------------------------------------------- deploy ---
.vercel
