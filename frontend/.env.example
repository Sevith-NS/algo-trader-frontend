# Next.js frontend — copy to frontend/.env.local and fill in.

# Base URL of the FastAPI backend. Server-only: read by the BFF proxy
# (src/app/api/backend) and src/lib/server-api.ts, never sent to the browser.
FLINT_API_URL=[YOUR_BACKEND_URL]

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
